{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};

	// The theme is registered once as "omarchy" and once per palette as
	// "omarchy-<palette>", all pointing at the same files.
	const palette = (index(theme, 'omarchy-') == 0) ? substr(theme, 8) : 'tokyo-night';

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-palette="{{ entityencode(palette, true) }}">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="darkreader-lock">
		<link rel="stylesheet" href="{{ media }}/base.css">
		<link rel="stylesheet" media="only screen and (max-device-width: 854px)" href="{{ media }}/base-mobile.css">
		<link rel="stylesheet" href="{{ media }}/palettes.css">
		<link rel="stylesheet" href="{{ media }}/omarchy.css">
		<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
		{% if (dispatched?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ dispatched.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script>
			/* Runs before the first paint, after the stylesheets above have loaded.
			   Applies this browser's palette choice, if it was made for the palette
			   the router currently serves, and tells the base stylesheet whether
			   the palette is dark. */
			(function(root) {
				var served = root.getAttribute('data-palette'), pick = null;
				var mode = function() { return getComputedStyle(root).getPropertyValue('--o-mode').trim() };

				try { pick = JSON.parse(localStorage.getItem('omarchy.palette')) } catch (e) {}

				/* a wallpaper of this browser's own, read here so pages do not flash */
				try {
					var look = JSON.parse(localStorage.getItem('omarchy.look')) || {};
					var wall = (look.wall && look.wall != 'colors') ? JSON.parse(localStorage.getItem('omarchy.wall')) : null;

					if (wall && wall.data && wall.data.length <= 2000000) {
						root.style.setProperty('--o-wall', 'url("' + wall.data + '")');
						root.style.setProperty('--o-wall-blur', (look.blur != null ? +look.blur : 8) + 'px');
						root.setAttribute('data-o-wall', look.wall);
					}
				} catch (e) {}

				if (pick && pick.served === served && typeof pick.id == 'string') {
					root.setAttribute('data-palette', pick.id);

					if (!mode())
						root.setAttribute('data-palette', served);
				}

				/* an alias that has no palette of its own gets the default one */
				if (!mode())
					root.removeAttribute('data-palette');

				root.setAttribute('data-served-palette', served);
				root.setAttribute('data-darkmode', mode() != 'light');
				{% if (!blank_page): %}

				/* Windows open with a small animation on the first page of a visit only. */
				try {
					if (!sessionStorage.getItem('omarchy.opened')) {
						sessionStorage.setItem('omarchy.opened', '1');
						root.setAttribute('data-o-first', '');
					}
				} catch (e) {}

				/* LuCI draws the bars, the menu and the view by script, so a page that
				   has just arrived is empty. The browser keeps a picture of the page
				   before on screen, and menu-omarchy.js takes it away once this one is
				   complete. A page coming back from the history is complete already. */
				if ('onpagereveal' in window) {
					root.setAttribute('data-o-hold', '');

					window.addEventListener('pagereveal', function(ev) {
						if (ev.viewTransition && root.hasAttribute('data-o-drawn'))
							ev.viewTransition.skipTransition();
						else
							window.oSwap = ev.viewTransition;
					});
				}
				{% endif %}
			})(document.documentElement);
		</script>
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	{#- data-page is what bootstrap sets (the requested path); data-o-view is the page that was actually dispatched. -#}
	<body class="lang_{{ dispatcher.lang }}" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}" data-o-view="{{ entityencode(join('-', ctx.path ?? []), true) }}">
		{% if (!blank_page): %}
		<header>
			<div class="o-bar-left">
				<button type="button" id="o-launch" style="visibility:hidden" title="{{ entityencode(_('Search'), true) }} (Ctrl+K)" aria-label="{{ entityencode(_('Search'), true) }}"></button>
				<a class="brand" href="/">{{ striptags(boardinfo.hostname ?? '?') }}</a>
				<ul class="nav" id="topmenu" style="display:none"></ul>
			</div>
			<div class="o-bar-mid" id="o-clock"></div>
			<div class="o-bar-right">
				<div id="indicators"></div>
				<div id="o-tray"></div>
			</div>
		</header>

		<div class="o-desk">
		<nav id="o-side"></nav>

		<div id="maincontent" class="container" data-o-title="{{ entityencode(sprintf('%s@%s: ~/%s', ctx.authuser ?? 'root', boardinfo.hostname ?? '?', join('/', slice(ctx.path ?? [], 1))), true) }}">
			{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
				<div class="alert-message warning">
					<h4>{{ _('No password set!') }}</h4>
					<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
					{% if (dispatcher.lookup("admin/system/admin")): %}
					  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			{% if (boardinfo.rootfs_type == "initramfs"): %}
				<div class="alert-message warning">
					<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
					<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
					{% if (dispatcher.lookup("admin/system/flash")): %}
					  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			<noscript>
				<div class="alert-message warning">
					<h4>{{ _('JavaScript required!') }}</h4>
					<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
				</div>
			</noscript>

			<div id="tabmenu" style="display:none"></div>
		{% endif %}
